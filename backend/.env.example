# Copy this file to .env and fill in your own values.
# Never commit the real .env.

MONGO_URL=mongodb://127.0.0.1:27017/utkarshstay
SESSION_SECRET=replace-with-a-long-random-string
PORT=8080
NODE_ENV=development

# Origin(s) allowed to call the API. Comma-separate for more than one.
CLIENT_URL=http://localhost:5173

# Cloudinary - leave blank to fall back to image URLs instead of uploads
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
